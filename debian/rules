#!/usr/bin/make -f

export PYBUILD_NAME=klamav_py

%:
	dh $@ --buildsystem=pybuild --with python3

# Unit utente (systemd --user), non di sistema: klamav-py è pensato per
# uso desktop personale, e una unit di sistema con DynamicUser=yes non
# riesce a leggere una home 0700/0750 né a condividere in modo sensato
# la directory di quarantena con la GUI (vedi commenti nei file .service
# per i dettagli). "--name=klamav-scan" fa cercare a dh_installsystemduser
# i file debian/klamav-py.klamav-scan.user.{service,timer} invece del
# solo debian/klamav-py.user.service.
override_dh_installsystemduser:
	dh_installsystemduser --name=klamav-scan
