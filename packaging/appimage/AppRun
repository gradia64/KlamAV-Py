#!/bin/sh
# Avvio dell'AppImage di KlamAV-Py. Il runtime monta l'immagine e imposta
# APPIMAGE (il file .AppImage), APPDIR (il punto di montaggio) e ARGV0 (il
# nome con cui è stata lanciata).
#
# Due entry point, come nei pacchetti:
#   KlamAV-Py-….AppImage [opzioni]        la GUI (klamav-py-gui)
#   KlamAV-Py-….AppImage cli [opzioni]    la CLI (klamav-py)
#   un collegamento chiamato klamav-py    la CLI, senza «cli»
HERE="$(dirname "$(readlink -f "$0")")"

# solo il Python e il Qt dell'AppImage: niente moduli, plugin Qt o
# impostazioni del sistema, che potrebbero essere di versioni diverse
unset PYTHONHOME PYTHONPATH PYTHONSTARTUP \
      QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QML2_IMPORT_PATH

entry=gui
case "${ARGV0:-$0}" in
    */klamav-py|klamav-py) entry=cli ;;
esac
if [ "$entry" = gui ] && [ "${1:-}" = cli ]; then
    entry=cli
    shift
fi

# -E ignora le altre variabili PYTHON*, -s i pacchetti in ~/.local
exec "$HERE/usr/python/bin/python3" -E -s "$HERE/usr/share/klamav-py/launcher.py" "$entry" "$@"
